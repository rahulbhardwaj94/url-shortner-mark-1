# Application
NODE_ENV=production
PORT=3000

# MySQL Configuration
MYSQL_HOST=your-ec2-mysql-host
MYSQL_PORT=3306
MYSQL_USERNAME=your-username
MYSQL_PASSWORD=your-secure-password
MYSQL_DATABASE=todo_app

# MongoDB Configuration
MONGODB_URI=mongodb://your-ec2-mongodb-host:27017/todo_app

# Redis Configuration
REDIS_HOST=your-ec2-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret
JWT_EXPIRES_IN=1d
